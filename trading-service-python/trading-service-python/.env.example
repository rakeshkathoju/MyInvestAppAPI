# ---------------------------------------------------------------------------
# Trading service configuration. Copy to .env and fill in your own values.
# Never commit a filled-in .env.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Execution mode --------------------------------------------------------
# paper | breeze (ICICI Direct) | motilal (Motilal Oswal)
# Start on paper. Only switch after your paper P&L proves the strategy.
TRADING_MODE=paper

# Set false to record signals without placing any order.
AUTO_EXECUTE=true

# When false, a SELL signal can only close an existing long position.
ALLOW_SHORT=false

# --- Webhook security ------------------------------------------------------
# Shared secret that TradingView/Chartink alerts must include.
# Leave empty to disable the check (NOT recommended once deployed publicly).
WEBHOOK_SECRET=change-me

# --- Risk management -------------------------------------------------------
PAPER_STARTING_CAPITAL=1000000
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=20.0
MAX_OPEN_POSITIONS=5
DEFAULT_STOP_LOSS_PCT=0.5
DEFAULT_TARGET_PCT=1.0
SLIPPAGE_PCT=0.02
BROKERAGE_PCT=0.03
SIGNAL_DEDUPE_SECONDS=300

ENFORCE_MARKET_HOURS=true
MARKET_OPEN=09:15
MARKET_CLOSE=15:30

# --- Optional AI confirmation filter ---------------------------------------
# When true, BUY signals are checked against the AI service before executing.
AI_CONFIRMATION_ENABLED=false
AI_SERVICE_URL=http://ai-service:8000
AI_MIN_CONFIDENCE=0.55
AI_TIMEOUT_SECONDS=8
AI_FAIL_OPEN=true

# --- Chartink screener polling --------------------------------------------
CHARTINK_SCAN_CLAUSE=
CHARTINK_POLL_SECONDS=300

# --- ICICI Direct (Breeze) -------------------------------------------------
# BREEZE_SESSION_TOKEN must be regenerated daily.
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_SESSION_TOKEN=

# --- Motilal Oswal ---------------------------------------------------------
MOTILAL_API_KEY=
MOTILAL_AUTH_TOKEN=
MOTILAL_CLIENT_CODE=
MOTILAL_BASE_URL=https://openapi.motilaloswal.com
